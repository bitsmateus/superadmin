# Banco Postgres
DATABASE_URL=postgres://user:password@localhost:5432/superadmin

# Segredo do JWT do painel (obrigatório)
JWT_SECRET=troque-por-um-segredo-forte

# Origem permitida para CORS (default *)
CORS_ORIGIN=*

# Porta do servidor (default 3001)
PORT=3001

# URL pública do painel (usada em links de e-mail/portais)
PUBLIC_APP_URL=https://app.seudominio.com.br

# NX Monitor — serviço separado de monitoramento de canais WhatsApp.
# A API key fica SÓ aqui no servidor e é injetada no proxy /api/canais/*.
NX_MONITOR_URL=https://monitor.seudominio.com.br
NX_MONITOR_API_KEY=

# API Oficial (WhatsApp templates) — usada SÓ nos avisos de canal
# (desconectado/reconectado/teste). Os demais avisos seguem o envio normal.
# Pode ser a base (.../external/SEU_API_ID) ou já com /templateBody — o código
# anexa /templateBody automaticamente se faltar.
OFFICIAL_API_URL=https://appapi.nxsystems.com.br/v2/api/external/SEU_API_ID/templateBody
OFFICIAL_API_TOKEN=
# (opcional) link do tutorial no template de canal desconectado
OFFICIAL_TUTORIAL_URL=https://ajuda.nxsystems.com.br/

# Geração de fluxo de chatbot com IA (Claude). A chave fica SÓ no servidor.
ANTHROPIC_API_KEY=
# Modelo (default claude-sonnet-5). Troque para claude-opus-5 se quiser mais qualidade.
ANTHROPIC_MODEL=claude-sonnet-5
# Tentativas de correção do roteiro quando a validação falha (default 2).
CHATBOT_FLOW_MAX_RETRIES=2
# Caminho da API do tenant que IMPORTA o fluxo. Vazio = publish responde 501
# (o download do JSON continua funcionando). Ex.: /v2/api/external/{apiId}/importFlow
CHATBOT_FLOW_IMPORT_PATH=
# Caminho da API do tenant que LISTA as filas (para resolver setor -> queueId).
# Default segue o padrão listXxxData do NX. Se não resolver, o operador ajusta
# o queueId à mão na aba Chatbot.
CHATBOT_FLOW_LIST_QUEUES_PATH=/v2/api/external/{apiId}/listQueueData

# Grupo de WhatsApp que recebe uma CÓPIA de todos os avisos de canal
# (desconectado/reconectado/teste). A cópia é enviada pela MESMA credencial do
# grupo de suporte (settings.support_group). Default: 120363409254876877.
ALERT_GROUP_ID=120363409254876877

# Webhook do Autentique — quando o documento é assinado por todo mundo, marca o
# contrato como assinado e avança o cliente pra Briefing sozinho. Cadastre a URL
# https://SEU_DOMINIO_API/api/webhooks/autentique no painel de desenvolvedor do
# Autentique (evento "document.finished") e cole aqui o segredo mostrado lá.
AUTENTIQUE_WEBHOOK_SECRET=

# Webhook de leads do Meta Ads — chamado pelo n8n (Meta Ads > Google Sheets > Apps Script > n8n)
# no lugar do node que cria item no Monday. Cadastre no n8n a URL
# https://SEU_DOMINIO_API/api/webhooks/meta-leads com o header
# "Authorization: Bearer SEU_TOKEN_AQUI" usando o valor abaixo.
META_LEADS_WEBHOOK_TOKEN=
# (opcional) id do quadro de destino em lead_boards. Vazio = usa o primeiro quadro da aba
# "Novos Leads" (o quadro de entrada do funil comercial).
META_LEADS_BOARD_ID=
